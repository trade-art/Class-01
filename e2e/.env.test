# E2E Test Environment Configuration
# This file contains environment variables for E2E testing

# ===========================================
# Application URLs
# ===========================================
E2E_BASE_URL=http://127.0.0.1:8181
E2E_API_URL=http://localhost:3200
E2E_PLATFORM_API_URL=http://localhost:3001
API_BASE_URL=http://localhost:3200
APP_URL=http://127.0.0.1:8181

# ===========================================
# Database Configuration
# ===========================================
E2E_DATABASE_URL=postgresql://mt5_user:mt5_password@localhost:5433/mt5_platform_test
DATABASE_URL=postgresql://mt5_user:mt5_password@localhost:5433/mt5_platform_test
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ===========================================
# Redis Configuration
# ===========================================
E2E_REDIS_URL=redis://localhost:6380
REDIS_URL=redis://localhost:6380
REDIS_PREFIX=mt5_test:

# ===========================================
# Mock MT5 Middleware
# ===========================================
E2E_MT5_MIDDLEWARE_URL=http://localhost:8083
MIDDLEWARE_URL=http://localhost:8083
MIDDLEWARE_TIMEOUT=10000
MIDDLEWARE_RETRY_COUNT=3

# ===========================================
# Test Credentials (matches seed data)
# ===========================================
# Demo Tenant Admin (from prisma seed.ts)
E2E_ADMIN_EMAIL=admin@demo.com
E2E_ADMIN_PASSWORD=demo123456
TEST_ADMIN_EMAIL=admin@demo.com
TEST_ADMIN_PASSWORD=demo123456
TEST_USER_EMAIL=admin@demo.com
TEST_USER_PASSWORD=demo123456
TEST_TENANT_CODE=demo

# ===========================================
# Authentication Configuration
# ===========================================
JWT_SECRET=test-jwt-secret-e2e-testing-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# Timeouts (ms)
# ===========================================
E2E_DEFAULT_TIMEOUT=30000
E2E_ACTION_TIMEOUT=15000
E2E_NAVIGATION_TIMEOUT=30000
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_EXPECT_TIMEOUT=5000

# ===========================================
# Test Settings
# ===========================================
E2E_HEADLESS=true
E2E_SLOW_MO=0
E2E_SCREENSHOT_ON_FAILURE=true
E2E_VIDEO_ON_FAILURE=true
RECORD_VIDEO=false
SCREENSHOT_ON_FAILURE=true
TRACE_ON_FAILURE=true

# ===========================================
# Performance Test Thresholds (ms)
# ===========================================
PERF_PAGE_LOAD_THRESHOLD=2000
PERF_API_RESPONSE_THRESHOLD=1000
PERF_SEARCH_THRESHOLD=500
PERF_LOGIN_THRESHOLD=1000

# ===========================================
# Mock Configuration
# ===========================================
ENABLE_MOCKS=false
MOCK_NETWORK_DELAY=50
MOCK_ERROR_RATE=0

# ===========================================
# CI/CD Configuration
# ===========================================
CI=false
GITHUB_ACTIONS=false
NODE_ENV=test
LOG_LEVEL=debug
