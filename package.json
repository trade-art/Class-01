{
  "name": "mt5-platform",
  "version": "1.0.0",
  "description": "MT5 SaaS Platform - Multi-tenant management system for MT5 middleware",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @mt5-platform/platform-service",
    "dev:web": "npm run dev -w @mt5-platform/platform-console",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w @mt5-platform/platform-service",
    "build:web": "npm run build -w @mt5-platform/platform-console",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "db:migrate": "npm run db:migrate -w @mt5-platform/platform-service",
    "db:generate": "npm run db:generate -w @mt5-platform/platform-service",
    "db:seed": "npm run db:seed -w @mt5-platform/platform-service"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "mt5",
    "metatrader",
    "saas",
    "multi-tenant",
    "trading-platform"
  ],
  "author": "MT5 Platform Team",
  "license": "UNLICENSED",
  "dependencies": {
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@faker-js/faker": "^9.2.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.5"
  }
}
