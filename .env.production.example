# Production Environment Configuration
# Copy this file to .env.production and fill in the values

# ==========================================
# Database Configuration (本机安装 PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://mt5admin:<DB_PASSWORD>@localhost:5432/mt5_platform

# Platform Service 数据库
PLATFORM_DATABASE_URL=postgresql://mt5admin:<DB_PASSWORD>@localhost:5432/mt5_platform?schema=platform

# Tenant API 数据库
TENANT_DATABASE_URL=postgresql://mt5admin:<DB_PASSWORD>@localhost:5432/mt5_platform?schema=tenant

# ==========================================
# Redis Configuration (Docker 运行)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==========================================
# Platform Service Configuration
# ==========================================
PLATFORM_PORT=3001
PLATFORM_JWT_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
PLATFORM_JWT_REFRESH_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# Tenant API Configuration
# ==========================================
TENANT_PORT=3002
TENANT_JWT_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
TENANT_JWT_REFRESH_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>

# ==========================================
# Frontend URLs
# ==========================================
PLATFORM_CONSOLE_URL=http://localhost:5173
TENANT_CONSOLE_URL=http://localhost:5174

# ==========================================
# MT5 Middleware Configuration (optional)
# ==========================================
# MT5_MIDDLEWARE_HOST=your-mt5-server
# MT5_MIDDLEWARE_PORT=443
# MT5_API_KEY=your-mt5-api-key
