# Production Environment Configuration
# Copy this file to .env.production and fill in the values

# ==========================================
# Database Configuration
# ==========================================
DB_USER=mt5admin
DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
DB_NAME=mt5_platform

# ==========================================
# Redis Configuration
# ==========================================
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ==========================================
# Platform Service JWT Configuration
# ==========================================
JWT_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
JWT_REFRESH_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# Tenant API JWT Configuration
# ==========================================
TENANT_JWT_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>
TENANT_JWT_REFRESH_SECRET=<CHANGE_ME_RANDOM_64_CHAR_STRING>

# ==========================================
# Domain Configuration (update for your domain)
# ==========================================
PLATFORM_DOMAIN=admin.yourdomain.com
TENANT_DOMAIN=app.yourdomain.com

# ==========================================
# SSL Configuration (for HTTPS)
# ==========================================
# SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# ==========================================
# MT5 Middleware Configuration (optional)
# ==========================================
# MT5_MIDDLEWARE_HOST=your-mt5-server
# MT5_MIDDLEWARE_PORT=443
# MT5_API_KEY=your-mt5-api-key
