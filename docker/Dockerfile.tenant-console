# =============================================================================
# MT5 Platform - Tenant Console Dockerfile
# Multi-stage build for Vue.js production application
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Dependencies - Install all dependencies
# -----------------------------------------------------------------------------
FROM node:20-alpine AS deps

WORKDIR /app

# Copy package files for dependency installation
COPY package.json package-lock.json ./
COPY apps/tenant-console/package.json ./apps/tenant-console/

# Install all dependencies (including devDependencies for build)
RUN npm ci --legacy-peer-deps

# -----------------------------------------------------------------------------
# Stage 2: Builder - Build the application
# -----------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Build arguments for environment configuration
ARG VITE_API_BASE_URL=/api
ARG VITE_APP_TITLE="MT5 Tenant Console"

# Set environment variables for build
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_APP_TITLE=${VITE_APP_TITLE}

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/tenant-console/node_modules ./apps/tenant-console/node_modules 2>/dev/null || true

# Copy source code
COPY package.json package-lock.json ./
COPY apps/tenant-console ./apps/tenant-console

# Build the application
RUN npm run build -w @mt5-platform/tenant-console

# -----------------------------------------------------------------------------
# Stage 3: Runner - Production image with Nginx
# -----------------------------------------------------------------------------
FROM nginx:alpine AS runner

# Add labels for image metadata
LABEL org.opencontainers.image.title="MT5 Tenant Console"
LABEL org.opencontainers.image.description="MT5 Platform Tenant Admin Console"
LABEL org.opencontainers.image.vendor="MT5 Platform Team"

# Remove default nginx config
RUN rm -rf /etc/nginx/conf.d/*

# Copy custom nginx configuration
COPY docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Copy built application
COPY --from=builder /app/apps/tenant-console/dist /usr/share/nginx/html

# Add non-root user for security
RUN addgroup -g 1001 -S nginx-user && \
    adduser -S -D -H -u 1001 -h /usr/share/nginx/html -s /sbin/nologin -G nginx-user nginx-user && \
    chown -R nginx-user:nginx-user /usr/share/nginx/html && \
    chown -R nginx-user:nginx-user /var/cache/nginx && \
    chown -R nginx-user:nginx-user /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx-user:nginx-user /var/run/nginx.pid

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
