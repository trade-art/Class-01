# Application
VITE_APP_TITLE=Tenant Console
VITE_APP_VERSION=1.0.0

# API Configuration
# For local development with Vite proxy: /api/v1
# For nginx deployment: /api/v1 (nginx strips prefix and routes to tenant-api)
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/ws

# Router base path
# For local development: / (default)
# For nginx deployment: /tenant/
VITE_ROUTER_BASE=/

# Build base path (static assets)
# For local development: / (default)
# For nginx deployment: /tenant/
# Set via env var when building: VITE_BASE=/tenant/ npm run build
VITE_BASE=/

# Feature Flags
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEVTOOLS=false

# Tenant Configuration (Optional - can be overridden per deployment)
# VITE_TENANT_CODE=default
# VITE_TENANT_API_URL=http://localhost:3002
