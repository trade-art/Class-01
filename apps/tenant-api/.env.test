# Test Environment Configuration
NODE_ENV=test
PORT=3002
API_PREFIX=tenant

# Database (共享 platform-service 数据库)
DATABASE_URL="postgresql://mt5admin:mt5platform2024@localhost:5433/mt5_platform?schema=platform"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT
JWT_SECRET=test-jwt-secret-e2e-testing-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-secret-e2e-testing-only
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5174,http://localhost:3001

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=500

# Middleware Proxy - Use Mock Service
MIDDLEWARE_BASE_URL=http://localhost:8888/api
MIDDLEWARE_TIMEOUT=10000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=2097152

# Logging
LOG_LEVEL=debug
