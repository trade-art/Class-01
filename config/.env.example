# =============================================================================
# MT5 Platform - Environment Configuration Template
# =============================================================================
# Copy this file to .env and customize for your environment
#
# Configuration Priority (highest to lowest):
# 1. Environment variables (OS level)
# 2. Secrets Manager (AWS/Azure/GCP)
# 3. .env file
# 4. Default values
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=info

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=mt5admin
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=mt5_platform
POSTGRES_PORT=5433

# Connection URLs
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=tenant
PLATFORM_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=platform

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-production
REDIS_DB=0

# Cache TTL (seconds)
CACHE_DEFAULT_TTL=60
CACHE_QUOTES_TTL=5
CACHE_POSITIONS_TTL=10
CACHE_ACCOUNTS_TTL=60
CACHE_SYMBOLS_TTL=300

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET=your-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Service Ports
# =============================================================================
TENANT_API_PORT=3000
PLATFORM_SERVICE_PORT=3001
TENANT_CONSOLE_PORT=5173
PLATFORM_CONSOLE_PORT=5174
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# =============================================================================
# Middleware Integration
# =============================================================================
MIDDLEWARE_BASE_URL=http://localhost:8080/api/v1
MIDDLEWARE_TIMEOUT=30000
MIDDLEWARE_RETRY_ATTEMPTS=3
MIDDLEWARE_PASSWORD_KEY=middleware-encryption-key

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

# =============================================================================
# Security Settings
# =============================================================================
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# =============================================================================
# Observability
# =============================================================================
METRICS_ENABLED=true
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=1.0
TEMPO_ENDPOINT=http://tempo:4317

# =============================================================================
# External Services (Optional)
# =============================================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_REPORTS_ENABLED=true
FEATURE_RISK_MANAGEMENT_ENABLED=true
