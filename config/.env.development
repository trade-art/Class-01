# =============================================================================
# MT5 Platform - Development Environment Configuration
# =============================================================================

NODE_ENV=development
APP_VERSION=dev
LOG_LEVEL=debug

# Database (local Docker)
POSTGRES_USER=mt5admin
POSTGRES_PASSWORD=mt5platform2024
POSTGRES_DB=mt5_platform
POSTGRES_PORT=5433

DATABASE_URL=postgresql://mt5admin:mt5platform2024@localhost:5433/mt5_platform?schema=tenant
PLATFORM_DATABASE_URL=postgresql://mt5admin:mt5platform2024@localhost:5433/mt5_platform?schema=platform

# Redis (local Docker)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis123
REDIS_DB=0

# JWT (development secrets - DO NOT USE IN PRODUCTION)
JWT_SECRET=dev-jwt-secret-for-local-development-only-32
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=dev-refresh-secret-for-local-development-32
JWT_REFRESH_EXPIRES_IN=7d

# Service Ports
TENANT_API_PORT=3000
PLATFORM_SERVICE_PORT=3001
TENANT_CONSOLE_PORT=5173
PLATFORM_CONSOLE_PORT=5174

# Middleware
MIDDLEWARE_BASE_URL=http://localhost:8080/api/v1
MIDDLEWARE_TIMEOUT=30000
MIDDLEWARE_PASSWORD_KEY=dev-middleware-key

# CORS (allow all localhost)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001

# Rate Limiting (relaxed for development)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=1000

# Security (weaker for faster development)
BCRYPT_ROUNDS=4
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION=60

# Observability
METRICS_ENABLED=true
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=1.0
TEMPO_ENDPOINT=http://localhost:4317

# Feature Flags
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_REPORTS_ENABLED=true
FEATURE_RISK_MANAGEMENT_ENABLED=true
