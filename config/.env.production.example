# =============================================================================
# MT5 Platform - Production Environment Configuration Template
# =============================================================================
#
# IMPORTANT: This is a template file. Do NOT commit actual secrets!
#
# For production, configure secrets using:
# 1. Environment variables (recommended for containers)
# 2. Docker secrets
# 3. Cloud secrets managers (AWS Secrets Manager, Azure Key Vault, etc.)
#
# =============================================================================

NODE_ENV=production
APP_VERSION=${APP_VERSION}
LOG_LEVEL=warn

# =============================================================================
# Database Configuration
# =============================================================================
# Use connection pooling and SSL in production
POSTGRES_USER=mt5admin
POSTGRES_DB=mt5_platform
POSTGRES_PORT=5432
# POSTGRES_PASSWORD - Set via secrets manager

# Connection URL with SSL
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db.example.com:5432/${POSTGRES_DB}?schema=tenant&sslmode=require
# PLATFORM_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db.example.com:5432/${POSTGRES_DB}?schema=platform&sslmode=require

# Connection Pool Settings
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT=10000

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD - Set via secrets manager

# Cluster mode (if using Redis Cluster)
# REDIS_CLUSTER_ENABLED=true
# REDIS_CLUSTER_NODES=redis-1:6379,redis-2:6379,redis-3:6379

# =============================================================================
# JWT Configuration
# =============================================================================
# JWT_SECRET - Set via secrets manager (min 64 characters)
# JWT_REFRESH_SECRET - Set via secrets manager (min 64 characters)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Service Configuration
# =============================================================================
TENANT_API_PORT=3000
PLATFORM_SERVICE_PORT=3001

# Replicas (for docker-compose scaling)
TENANT_API_REPLICAS=2
PLATFORM_SERVICE_REPLICAS=2
GATEWAY_REPLICAS=2

# =============================================================================
# Middleware Integration
# =============================================================================
MIDDLEWARE_BASE_URL=https://middleware.example.com/api/v1
MIDDLEWARE_TIMEOUT=30000
MIDDLEWARE_RETRY_ATTEMPTS=3
# MIDDLEWARE_PASSWORD_KEY - Set via secrets manager

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=https://mt5-platform.example.com,https://admin.mt5-platform.example.com

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

# Per-tenant limits (optional)
# RATE_LIMIT_TENANT_DEFAULT=1000
# RATE_LIMIT_TENANT_PREMIUM=5000

# =============================================================================
# Security Settings
# =============================================================================
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800

# Additional security headers
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_ENABLED=true

# =============================================================================
# Observability
# =============================================================================
METRICS_ENABLED=true
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1
TEMPO_ENDPOINT=http://tempo:4317

# Log aggregation
LOG_FORMAT=json
LOG_REDACT_FIELDS=password,token,secret,key

# =============================================================================
# SSL/TLS
# =============================================================================
SSL_ENABLED=true
# SSL_CERT_PATH=/etc/ssl/certs/server.crt
# SSL_KEY_PATH=/etc/ssl/private/server.key

# =============================================================================
# External Integrations
# =============================================================================
# SLACK_WEBHOOK_URL - Set via secrets manager
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER - Set via secrets manager
# SMTP_PASSWORD - Set via secrets manager

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_REPORTS_ENABLED=true
FEATURE_RISK_MANAGEMENT_ENABLED=true

# =============================================================================
# Backup Configuration
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET - Set via secrets manager
# BACKUP_S3_ACCESS_KEY - Set via secrets manager
# BACKUP_S3_SECRET_KEY - Set via secrets manager
