# =============================================================================
# MT5 Platform - Staging Environment Configuration
# =============================================================================
# Note: Sensitive values should be overridden by environment variables
# or secrets manager in CI/CD pipeline
# =============================================================================

NODE_ENV=staging
APP_VERSION=${APP_VERSION:-staging}
LOG_LEVEL=info

# Database
# Values should be set via GitHub Secrets: STAGING_DATABASE_URL
POSTGRES_USER=mt5admin
POSTGRES_DB=mt5_platform_staging
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=24h

# Service Ports (internal)
TENANT_API_PORT=3000
PLATFORM_SERVICE_PORT=3001

# CORS
CORS_ORIGINS=https://staging.mt5-platform.example.com,https://staging-admin.mt5-platform.example.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=500

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# Observability
METRICS_ENABLED=true
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.5
TEMPO_ENDPOINT=http://tempo:4317

# Feature Flags
FEATURE_WEBSOCKET_ENABLED=true
FEATURE_REPORTS_ENABLED=true
FEATURE_RISK_MANAGEMENT_ENABLED=true

# =============================================================================
# Required Secrets (must be set externally)
# =============================================================================
# DATABASE_URL - via GitHub Secrets
# PLATFORM_DATABASE_URL - via GitHub Secrets
# POSTGRES_PASSWORD - via GitHub Secrets
# REDIS_PASSWORD - via GitHub Secrets
# JWT_SECRET - via GitHub Secrets
# JWT_REFRESH_SECRET - via GitHub Secrets
# MIDDLEWARE_PASSWORD_KEY - via GitHub Secrets
